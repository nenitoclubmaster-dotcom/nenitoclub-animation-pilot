{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["episode_id", "language", "duration_s", "scenes"],
  "properties": {
    "episode_id": {"type": "string"},
    "language": {"type": "string"},
    "duration_s": {"type": "number", "minimum": 1},
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "start", "end", "characters", "action"],
        "properties": {
          "id": {"type": "string"},
          "start": {"type": "number"},
          "end": {"type": "number"},
          "characters": {"type": "array", "items": {"type": "string"}},
          "action": {"type": "string"},
          "motion_id": {"type": ["string", "null"]},
          "narration": {"type": ["string", "null"]},
          "camera": {"type": ["string", "null"]},
          "scene_asset": {"type": ["string", "null"]}
        }
      }
    }
  }
}
